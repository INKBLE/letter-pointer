<schemalist>
  <schema id="org.gnome.shell.extensions.letter-pointer" path="/org/gnome/shell/extensions/letter-pointer/">
    <key name="letter-pointer-activate" type="as">
      <default>['&lt;Alt&gt;m']</default>
      <summary>Open letter selection</summary>
    </key>
    <key name="letter-pointer-menu" type="as">
      <default>['&lt;Control&gt;&lt;Super&gt;m']</default>
      <summary>Activate without Alt or changing application focus</summary>
    </key>
    <key name="font-size" type="i">
      <default>11</default><range min="9" max="24"/>
      <summary>Label font size in logical pixels</summary>
    </key>
    <key name="background-opacity" type="d">
      <default>0.45</default><range min="0.0" max="1.0"/>
      <summary>Label background opacity</summary>
    </key>
    <key name="grid-spacing" type="i">
      <default>40</default><range min="24" max="140"/>
      <summary>Minimum grid spacing in logical pixels</summary>
    </key>
  </schema>
</schemalist>
